<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup on Android 11 and older (see data_extraction_rules.xml for newer versions).
    Trips and settings may be backed up; the session file is not, because it holds the login
    token, and a restored copy on another phone should not be signed in.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/session.preferences_pb" />
</full-backup-content>
