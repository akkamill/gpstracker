<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and phone-to-phone transfer on Android 12 and newer. Trips and settings may be
    copied; the session file is not, because it holds the login token.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
